#: data/scripts/upgrade.php:44
msgid "Missing requirement. Unable to upgrade."
msgstr "Prérequis absent. Impossible de mettre à jour."

#: Module.php:85
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr ""
"Le module « %1$s » doit être mis à niveau à la version « %2$s » ou "
"supérieure."

#: Module.php:95
#, php-format
msgid ""
"The library \"%s\" should be installed. See module’s installation "
"documentation."
msgstr ""
"La dépendance \"%s\" doit être installée. Consulter la documentation "
"d’installation du module."

#: data/scripts/upgrade.php:200
msgid ""
"Last version of Universal Viewer (v4) has been integrated. Check if it works "
"fine with your documents."
msgstr ""
"La dernière version d’Universal Viewer (v4) a été intégrée. Vérifiez si elle "
"fonctionne bien avec vos documents."

#: data/scripts/upgrade.php:217
msgid ""
"A param in settings (default) and in site settings allows to set the config "
"of Universal Viewer version 4. See {link}documentation{link_end}."
msgstr ""
"Un paramètre général et un paramètre pour chaque site permettent de "
"personnaliser la config d’Universal Viewer version 4. Consulter la {link}"
"documentation{link_end}."

#: data/scripts/upgrade.php:241
msgid ""
"The option \"Show on browse\" has been replaced by a placement option with "
"more granularity."
msgstr ""
"L’option \"Voir sur les listes\" a été remplacée par une option de placement "
"avec plus de possibilités.."

#: data/scripts/upgrade.php:277
msgid ""
"Universal Viewer version was not updated to v4 for {list} because custom "
"config was found. Please check and update manually."
msgstr ""
"La version d’Universal Viewer n’a pas été mise à la version 4 pour {list} en "
"raison de paramètres personnalisés. Merci de vérifier et de mettre à jour "
"manuellement."

#: data/scripts/upgrade.php:283
msgid "Universal Viewer version has been set to v4 for all settings and sites."
msgstr "La version 4 d’Universal Viewer a été définie dans tous les sites."

